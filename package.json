{
  "name": "dsh-connect-telegram",
  "version": "1.0.0",
  "description": "通过 Telegram 遥控 DeepSeek Harness：全中文界面、跨项目列举与切换会话、双向收发图片文件、历史对话翻阅。Drive DSH sessions from a Telegram bot.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*",
    "./lib/*.js": "./lib/*.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "telegram",
    "telegram-bot",
    "remote-control",
    "chatbot",
    "channel",
    "plugin",
    "zh-cn"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengling-windy/dsh-connect-telegram.git"
  },
  "homepage": "https://github.com/fengling-windy/dsh-connect-telegram#readme",
  "bugs": {
    "url": "https://github.com/fengling-windy/dsh-connect-telegram/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
